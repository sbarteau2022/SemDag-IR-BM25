;; macOS Seatbelt profile: no network except loopback and Unix sockets.
;; Use: sandbox-exec -f Tools/seatbelt/no_network.sb <command>
;; Allowed: outbound to localhost (model server, telemetry proxy), binding and
;; accepting on localhost (so those servers can run inside the profile), and Unix
;; sockets (Docker Desktop). Everything else is denied, matching the scorer's
;; offline rule. Task containers are separately started with network_disabled=True.
;; Verified 2026-11-17 on macOS 27.0.1: external HTTP -> 000/exit 7, loopback -> ok,
;; docker info -> ok, local bind+connect -> ok. A broad `(local ip "localhost:*")`
;; rule on network* let external traffic through, so it is deliberately absent.
(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote unix-socket))
