{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:decision-packet:0.1.0",
  "title": "Adversarially checked decision packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "snapshot_id", "snapshot_sha256", "target", "outline_claims", "edit_contract", "verdict", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^S7:[A-Z0-9_-]+$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "snapshot_ref"],
      "properties": {
        "path": {"type": "string", "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
        "symbol": {"type": "string", "minLength": 1},
        "snapshot_ref": {"type": "string", "pattern": "^S7:F[0-9]+$"}
      }
    },
    "outline_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "snapshot_refs", "verdict", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^O[0-9]+$"},
          "statement": {"type": "string", "minLength": 1},
          "snapshot_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "verdict": {"enum": ["supported", "contradicted", "missing", "stale"]},
          "critical": {"type": "boolean", "default": true},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "edit_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_files", "required_change", "preserve", "forbidden"],
      "properties": {
        "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "required_change": {"type": "string", "minLength": 1},
        "preserve": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "verification_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verdict": {"enum": ["implement", "relocalize", "fallback", "no_patch"]},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
