{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:command-receipt:0.1.0",
  "title": "Targeted verification command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "patch_sha256", "command_id", "command", "started_at", "duration_ms", "exit_code", "status", "stdout_sha256", "stderr_sha256", "stdout_artifact", "stderr_artifact", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command_id": {"type": "string", "pattern": "^CMD:[A-Z0-9_-]+$"},
    "command": {"type": "string", "minLength": 1, "maxLength": 4000},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "exit_code": {"type": ["integer", "null"]},
    "status": {"enum": ["passed", "failed", "timeout", "missing_dependency", "skipped"]},
    "stdout_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "stdout_artifact": {"type": ["string", "null"]},
    "stderr_artifact": {"type": ["string", "null"]},
    "reason": {"type": "string", "maxLength": 4000},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"exit_code": {"const": 0}, "stdout_sha256": {"type": "string"}, "stderr_sha256": {"type": "string"}, "stdout_artifact": {"type": "string"}, "stderr_artifact": {"type": "string"}}}},
    {"if": {"properties": {"status": {"enum": ["skipped", "timeout", "missing_dependency"]}}}, "then": {"required": ["reason"]}}
  ]
}
