{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:controller-ledger:0.1.0",
  "title": "Per-task brigade controller ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "base_commit", "model", "profile_sha256", "started_at", "status", "events", "ledger_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "model": {"const": "gemma-4-e4b-it-qat-w4a16-ct"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["running", "completed", "failed", "no_patch", "budget_exhausted"]},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "lane", "event", "status", "monotonic_ms", "tool_calls_total", "artifact_sha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "lane": {"enum": ["controller", "C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8", "S", "I", "F"]},
          "event": {"enum": ["start", "commit", "reject", "retry", "fallback", "stop"]},
          "status": {"enum": ["complete", "partial", "empty", "malformed", "stale", "budget_exhausted", "blocked", "no_patch"]},
          "monotonic_ms": {"type": "integer", "minimum": 0},
          "tool_calls_total": {"type": "integer", "minimum": 0},
          "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "maxLength": 2000},
          "supersedes_sequence": {"type": "integer", "minimum": 1}
        }
      }
    },
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
