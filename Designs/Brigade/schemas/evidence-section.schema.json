{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:evidence-section:0.1.0",
  "title": "Brigade evidence section",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "compartment", "producer", "attempt", "status", "input_digests", "claims", "payload", "content_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "compartment": {"type": "integer", "minimum": 1, "maximum": 8},
    "producer": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "status": {"enum": ["complete", "partial", "empty", "malformed", "budget_exhausted", "stale"]},
    "input_digests": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9:_-]+$"}, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "statement", "snapshot_refs", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[1-8]:[A-Z][0-9]+$"},
          "label": {"enum": ["VERIFIED", "REPORTED", "INFERRED", "PROPOSED"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
          "snapshot_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_boundary": {"type": "string", "maxLength": 2000}
        },
        "allOf": [
          {
            "if": {"properties": {"label": {"const": "INFERRED"}}, "required": ["label"]},
            "then": {"required": ["evidence_boundary"]}
          },
          {
            "if": {"properties": {"label": {"enum": ["VERIFIED", "REPORTED", "INFERRED"]}}, "required": ["label"]},
            "then": {"properties": {"snapshot_refs": {"minItems": 1}}}
          }
        ]
      }
    },
    "payload": {"type": "object", "minProperties": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"compartment": {"const": 1}}}, "then": {"properties": {"payload": {"required": ["candidates", "misses"]}}}},
    {"if": {"properties": {"compartment": {"const": 2}}}, "then": {"properties": {"payload": {"required": ["hypotheses"]}}}},
    {"if": {"properties": {"compartment": {"const": 3}}}, "then": {"properties": {"payload": {"required": ["blocks", "losses"]}}}},
    {"if": {"properties": {"compartment": {"const": 4}}}, "then": {"properties": {"payload": {"required": ["risks"]}}}},
    {"if": {"properties": {"compartment": {"const": 5}}}, "then": {"properties": {"payload": {"required": ["relations"]}}}},
    {"if": {"properties": {"compartment": {"const": 6}}}, "then": {"properties": {"payload": {"required": ["apis"]}}}},
    {"if": {"properties": {"compartment": {"const": 7}}}, "then": {"properties": {"payload": {"required": ["snapshot_id"]}}}},
    {"if": {"properties": {"compartment": {"const": 8}}}, "then": {"properties": {"payload": {"required": ["patch_sha256", "judge_receipts", "unresolved"]}}}}
  ]
}
