{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:host-export:0.1.0",
  "title": "Out-of-patch brigade audit export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "base_commit", "patch_sha256", "ledger_sha256", "captured_at", "artifacts", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,80}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size_bytes"],
        "properties": {
          "kind": {"enum": ["snapshot", "evidence", "decision", "judge", "patch", "controller", "implementation", "verification"]},
          "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
