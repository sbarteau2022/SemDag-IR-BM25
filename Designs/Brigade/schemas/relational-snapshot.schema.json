{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:relational-snapshot:0.1.0",
  "title": "Immutable relational snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "repository", "snapshot_id", "base_commit", "captured_at", "files", "relations", "snapshot_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^S7:[A-Z0-9_-]+$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "graph_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "embedding_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "path", "file_sha256", "start_line", "end_line", "exact_source", "source_sha256", "role"],
        "properties": {
          "ref": {"type": "string", "pattern": "^S7:F[0-9]+$"},
          "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
          "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "exact_source": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "symbol": {"type": ["string", "null"]},
          "role": {"enum": ["target", "caller", "callee", "sibling", "type", "import", "test", "usage"]}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "from_ref", "to_ref", "kind", "evidence_refs", "status"],
        "properties": {
          "ref": {"type": "string", "pattern": "^S7:E[0-9]+$"},
          "from_ref": {"type": "string", "pattern": "^S7:F[0-9]+$"},
          "to_ref": {"type": "string", "pattern": "^S7:F[0-9]+$"},
          "kind": {"enum": ["calls", "called_by", "imports", "reads", "writes", "inherits", "tests", "analogous"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S7:F[0-9]+$"}, "uniqueItems": true},
          "status": {"enum": ["observed", "inferred"]},
          "graph_ref": {"type": ["string", "null"]}
        }
      }
    },
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
