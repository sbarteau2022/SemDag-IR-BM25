{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:implementation-result:0.1.0",
  "title": "Sole-implementer source delta receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "packet_sha256", "snapshot_sha256", "base_commit", "status", "changed_files", "patch_sha256", "result_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "status": {"enum": ["applied", "stale", "rejected", "no_patch", "budget_exhausted"]},
    "changed_files": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "preimage_sha256", "postimage_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
          "preimage_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "postimage_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "patch_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "maxLength": 4000},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "applied"}}}, "then": {"properties": {"changed_files": {"minItems": 1}, "patch_sha256": {"type": "string"}}}},
    {"if": {"properties": {"status": {"enum": ["stale", "rejected", "no_patch", "budget_exhausted"]}}}, "then": {"properties": {"changed_files": {"maxItems": 0}, "patch_sha256": {"type": "null"}}, "required": ["reason"]}}
  ]
}
