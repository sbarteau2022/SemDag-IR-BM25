{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemma-brigade:judge-receipt:0.1.0",
  "title": "Deterministic judge receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "gate", "judge_type", "passed", "observed_at", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "gate": {"type": "string", "pattern": "^Q[0-6][A-Za-z0-9_-]*$"},
    "judge_type": {"enum": ["file_exists", "nonempty", "contains", "command", "golden_sha256", "schema", "hash_match"]},
    "command": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "passed": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"},
    "stdout_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "stdout_text": {"type": "string", "maxLength": 5000},
    "stderr_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "stderr_text": {"type": "string", "maxLength": 5000},
    "details": {"type": "string", "maxLength": 8000},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
